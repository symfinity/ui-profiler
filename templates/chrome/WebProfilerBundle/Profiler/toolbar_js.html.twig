{# Owned WDT bootstrap — symfinity 044 (WDT-1). No stock Sfjs IIFE. #}
<!-- START of Symfony Web Debug Toolbar --><div id="sfTB-{{ token }}" data-ui-profiler-wdt-root data-ui-profiler-wdt-state="open" data-frankenphp-hot-reload-preserve data-no-turbolink data-turbo="false"><script{% if csp_script_nonce is defined and csp_script_nonce %} nonce="{{ csp_script_nonce }}"{% endif %}>(function(k){var e=document.getElementById('sfTB-{{ token|e('js') }}');e&&localStorage[k]=='closed'&&e.setAttribute('data-ui-profiler-wdt-state','closed')})('symfony/profiler/toolbar/displayState')</script>{% if ui_profiler_wdt_critical_css_inline() %}<style{% if csp_style_nonce is defined and csp_style_nonce %} nonce="{{ csp_style_nonce }}"{% endif %}>{{ ui_profiler_wdt_critical_css()|raw }}</style>{% endif %}<div id="sfwdt{{ token }}">{{ include('@UiProfiler/_wdt/bootstrap-skeleton.html.twig', { token: token, profiler_url: url('_profiler', {token: token}) }) }}</div><link rel="stylesheet" href="{{ path('_wdt_stylesheet', { v: ui_profiler_asset_version() }) }}"{% if csp_style_nonce is defined and csp_style_nonce %} nonce="{{ csp_style_nonce }}"{% endif %}><script type="module"{% if csp_script_nonce is defined and csp_script_nonce %} nonce="{{ csp_script_nonce }}"{% endif %}>import{UiProfilerWdt}from'{{ path('ui_profiler_asset', {assetPath: 'js/wdt.js', v: ui_profiler_asset_version()}) }}';UiProfilerWdt.boot({token:'{{ token|e('js') }}',wdtUrl:'{{ url('_wdt', {token: 'xxxxxx'})|escape('js') }}',profilerHomeUrl:'{{ url('_profiler_home')|escape('js') }}',excludedAjaxPaths:{{ excluded_ajax_paths|json_encode|raw }},basePath:'{{ request.basePath|e('js') }}',schemeAndHostBase:'{{ (request.schemeAndHttpHost ~ request.basePath)|e('js') }}'});</script></div><!-- END of Symfony Web Debug Toolbar -->
