<header data-ui-profiler-header>
    <h1>
        <span data-ui-profiler-header-brand>
            <span data-ui-profiler-header-mark aria-hidden="true">{{ source('@UiProfiler/Collector/icon.svg') }}</span>
            <span>
                <span data-ui-profiler-header-eyebrow>Symfinity</span>
                <twig:Link href="{{ path('_profiler_home') }}" variant="neutral" appearance="ghost">UI Profiler</twig:Link>
            </span>
        </span>
    </h1>

    <div data-ui-profiler-header-actions>
        <twig:Button
            as="a"
            href="{{ path('_profiler_search', {limit: 10, type: profile_type|default('request')}) }}"
            variant="neutral"
            appearance="outline"
            size="sm"
        >
            {{ source('@WebProfiler/Icon/search.svg') }}
            Search profiles
        </twig:Button>
    </div>
</header>
