{% extends '@UiProfiler/Profiler/layout.html.twig' %}

{% block head %}
    {{ parent() }}
{% endblock %}

{% block toolbar %}
    {% set has_time_events = collector.events|length > 0 %}
    {% set total_time = has_time_events ? '%.0f'|format(collector.duration) : 'n/a' %}
    {% set initialization_time = collector.events|length ? '%.0f'|format(collector.inittime) : 'n/a' %}
    {% set status_color = has_time_events and collector.duration > 1000 ? 'yellow' %}

    {% set icon %}
        {{ source('@WebProfiler/Icon/time.svg') }}
        <span data-ui-profiler-wdt-value>{{ total_time }}</span>
        <span data-ui-profiler-wdt-label>ms</span>
    {% endset %}

    {% set text %}
        <div data-ui-profiler-wdt-info-piece>
            <b>Total time</b>
            <span>{{ total_time }} ms</span>
        </div>
        <div data-ui-profiler-wdt-info-piece>
            <b>Initialization time</b>
            <span>{{ initialization_time }} ms</span>
        </div>
    {% endset %}

    {{ include('@WebProfiler/Profiler/toolbar_item.html.twig', {link: profiler_url, status: status_color}) }}
{% endblock %}

{% block menu %}
    {{ include('@UiProfiler/_chrome/partials/collector-menu-label.html.twig', {
        icon: source('@WebProfiler/Icon/time.svg'),
        title: 'Performance',
    }) }}
{% endblock %}

{% block panel %}
    <div data-ui-profiler-panel="time">
    {% set has_time_events = collector.events|length > 0 %}
    {{ include('@UiProfiler/_chrome/partials/collector-panel-heading.html.twig', { title: 'Performance metrics' }) }}
    <div data-ui-metrics-grid data-ui-role="grid">
        <div data-ui-role="stat-group">
            {{ include('@UiProfiler/_chrome/partials/profiler-metric-cell.html.twig', {
                value: '%.0f'|format(collector.duration),
                unit: 'ms',
                label: 'Total execution time',
            }) }}
            {{ include('@UiProfiler/_chrome/partials/profiler-metric-cell.html.twig', {
                value: '%.0f'|format(collector.inittime),
                unit: 'ms',
                label: 'Symfony initialization',
            }) }}
        </div>

        {% if profile.collectors.memory %}
            {{ include('@UiProfiler/_chrome/partials/profiler-metric-cell.html.twig', {
                value: '%.2f'|format(profile.collectors.memory.memory / 1024 / 1024),
                unit: 'MiB',
                label: 'Peak memory usage',
            }) }}
        {% endif %}

        {% if profile.children|length > 0 %}
            {% set subrequests_time = has_time_events
                ? profile.children|reduce((total, child) => total + child.getcollector('time').events.__section__.duration, 0)
                : 'n/a' %}
            <div data-ui-role="stat-group">
                {{ include('@UiProfiler/_chrome/partials/profiler-metric-cell.html.twig', {
                    value: profile.children|length,
                    label: 'Sub-' ~ profile_type|title ~ (profile.children|length > 1 ? 's' : ''),
                }) }}
                {{ include('@UiProfiler/_chrome/partials/profiler-metric-cell.html.twig', {
                    value: subrequests_time,
                    unit: 'ms',
                    label: 'Sub-' ~ profile_type|title ~ (profile.children|length > 1 ? 's' : '') ~ ' time',
                }) }}
            </div>
        {% endif %}
    </div>

    {{ include('@UiProfiler/_chrome/partials/collector-panel-heading.html.twig', { title: 'Execution timeline' }) }}
    {% if not collector.isStopwatchInstalled() %}
        <div data-ui-role="empty" data-ui-profiler-empty-panel>
            <p>The Stopwatch component is not installed. If you want to see timing events, run: <code>composer require symfony/stopwatch</code>.</p>
        </div>
    {% elseif collector.events is empty %}
        <div data-ui-role="empty">
            <p>No timing events have been recorded. Check that symfony/stopwatch is installed and debugging enabled in the kernel.</p>
        </div>
    {% else %}
        {{ block('panelContent') }}
    {% endif %}
    </div>
{% endblock %}

{% block panelContent %}
    <form id="timeline-control" action="" method="get">
        <input type="hidden" name="panel" value="time">
        <label for="threshold">Threshold</label>
        <input type="number" name="threshold" id="threshold" value="1" min="0" placeholder="1.1" data-ui-role="input"> ms
        <span data-ui-role="typography" data-ui-variant="help">(timeline only displays events with a duration longer than this threshold)</span>
    </form>

    {% if profile.parent %}
        <h3 data-ui-role="typography" data-ui-variant="h3" class="dump-inline">
            Sub-{{ profile_type|title }} {{ profiler_dump(profile.getcollector('request').requestattributes.get('_controller')) }}
            <small>
                {{ collector.events.__section__.duration }} ms
                <a data-ui-display="block" href="{{ path('_profiler', {token: profile.parent.token, panel: 'time'}) }}">Return to parent {{ profile_type }}</a>
            </small>
        </h3>
    {% elseif profile.children|length > 0 %}
        <h3 data-ui-role="typography" data-ui-variant="h3">
            Main {{ profile_type|title }} <small>{{ collector.events.__section__.duration }} ms</small>
        </h3>
    {% endif %}

    {{ _self.display_timeline(token, collector.events, collector.events.__section__.origin) }}

    {% if profile.children|length %}
        <p data-ui-role="typography" data-ui-variant="help">Note: sections with a striped background correspond to sub-{{ profile_type }}s.</p>

        <h3 data-ui-role="typography" data-ui-variant="h3">Sub-{{ profile_type }}s <small>({{ profile.children|length }})</small></h3>

        {% for child in profile.children %}
            {% set events = child.getcollector('time').events %}
            <h4 data-ui-role="typography" data-ui-variant="h4">
                <a href="{{ path('_profiler', {token: child.token, panel: 'time'}) }}">{{ child.getcollector('request').identifier }}</a>
                <small>{{ events.__section__.duration }} ms</small>
            </h4>

            {{ _self.display_timeline(child.token, events, collector.events.__section__.origin) }}
        {% endfor %}
    {% endif %}

<svg id="timeline-template" width="0" height="0">
  <defs>
    <pattern id="subrequest" class="timeline-subrequest-pattern" patternUnits="userSpaceOnUse" width="20" height="20" viewBox="0 0 40 40">
        <path d="M0 40L40 0H20L0 20M40 40V20L20 40"/>
    </pattern>
  </defs>
</svg>
<script type="module"{% if csp_script_nonce is defined and csp_script_nonce %} nonce="{{ csp_script_nonce }}"{% endif %}>import{bootTimePanel}from'{{ path('ui_profiler_asset', {assetPath: 'js/panels/time-timeline.js', v: ui_profiler_asset_version()}) }}';window.addEventListener('load',()=>bootTimePanel());</script>
{% endblock %}

{% macro display_timeline(token, events, origin) %}
    <div data-ui-profiler-timeline>
        <script type="application/json" data-ui-profiler-timeline-data>{{ _self.dump_request_data_json(token, events, origin)|raw }}</script>
        <div id="legend-{{ token }}" class="legends"></div>
        <svg id="timeline-{{ token }}" class="timeline-graph"></svg>
    </div>
{% endmacro %}

{% macro dump_request_data_json(token, events, origin) %}
{"id":"{{ token|e('js') }}","left":{{ '%F'|format(events.__section__.origin - origin) }},"end":{{ '%F'|format(events.__section__.endtime) }},"events":[{{ _self.dump_events_json(events) }}]}
{% endmacro %}

{% macro dump_events_json(events) %}
{% for name, event in events %}
{% if '__section__' != name %}
{"name":{{ name|json_encode|raw }},"category":{{ event.category|json_encode|raw }},"origin":{{ '%F'|format(event.origin) }},"starttime":{{ '%F'|format(event.starttime) }},"endtime":{{ '%F'|format(event.endtime) }},"duration":{{ '%F'|format(event.duration) }},"memory":{{ '%.1F'|format(event.memory / 1024 / 1024) }},"elements":{},"periods":[{% for period in event.periods %}{"start":{{ '%F'|format(period.starttime) }},"end":{{ '%F'|format(period.endtime) }},"duration":{{ '%F'|format(period.duration) }},"elements":{}}{% if not loop.last %},{% endif %}{% endfor %}]}{% if not loop.last %},{% endif %}
{% endif %}
{% endfor %}
{% endmacro %}
