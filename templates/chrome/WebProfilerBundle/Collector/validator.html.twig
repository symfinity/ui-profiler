{% extends '@UiProfiler/Profiler/layout.html.twig' %}

{% block head %}
    {{ parent() }}
{% endblock %}

{% block toolbar %}
    {% if collector.violationsCount > 0 or collector.calls|length %}
        {% set status_color = collector.violationsCount ? 'red' %}
        {% set icon %}
            {{ source('@WebProfiler/Icon/validator.svg') }}
            <span class="sf-toolbar-value">
                {{ collector.violationsCount ?: collector.calls|length }}
            </span>
        {% endset %}

        {% set text %}
            {{ include('@UiProfiler/_chrome/partials/toolbar-metric.html.twig', {
                label: 'Validator calls',
                value: collector.calls|length,
                status_class: 'sf-toolbar-status',
            }) }}
            {{ include('@UiProfiler/_chrome/partials/toolbar-metric.html.twig', {
                label: 'Number of violations',
                value: collector.violationsCount,
                status_class: 'sf-toolbar-status' ~ (collector.violationsCount > 0 ? ' sf-toolbar-status-red' : ''),
            }) }}
        {% endset %}

        {{ include('@WebProfiler/Profiler/toolbar_item.html.twig', {link: profiler_url, status: status_color}) }}
    {% endif %}
{% endblock %}

{% block menu %}
    {{ include('@UiProfiler/_chrome/partials/collector-menu-label.html.twig', {
        icon: source('@WebProfiler/Icon/validator.svg'),
        title: 'Validator',
        status: collector.violationsCount ? 'error' : null,
        disabled: collector.calls is empty,
        count: collector.violationsCount > 0 ? collector.violationsCount : null,
    }) }}
{% endblock %}

{% block panel %}
    <div data-ui-profiler-panel="validator">
    <h2>Validator calls</h2>

    {% for call in collector.calls %}
        <div class="sf-validator sf-reset">
            <span class="metadata">In
                {% set caller = call.caller %}
                {% if caller.line %}
                    {% set link = caller.file|file_link(caller.line) %}
                    {% if link %}
                        <a href="{{ link }}" title="{{ caller.file }}">{{ caller.name }}</a>
                    {% else %}
                        <abbr title="{{ caller.file }}">{{ caller.name }}</abbr>
                    {% endif %}
                {% else %}
                    {{ caller.name }}
                {% endif %}
                line <button type="button" class="btn-link text-small sf-toggle" data-toggle-selector="#sf-trace-{{ loop.index0 }}">{{ caller.line }}</button> (<button type="button" class="btn-link text-small sf-toggle" data-toggle-selector="#sf-context-{{ loop.index0 }}">context</button>):
            </span>

            <div class="sf-validator-compact hidden" id="sf-trace-{{ loop.index0 }}">
                {{ include('@UiProfiler/_chrome/partials/code-block.html.twig', {
                    content: caller.file|file_excerpt(caller.line)|replace({
                        '#DD0000': 'var(--highlight-string)',
                        '#007700': 'var(--highlight-keyword)',
                        '#0000BB': 'var(--highlight-default)',
                        '#FF8000': 'var(--highlight-comment)',
                    }),
                }) }}
            </div>

            <div class="sf-validator-compact hidden sf-validator-context" id="sf-context-{{ loop.index0 }}">
                {{ profiler_dump(call.context, maxDepth: 1) }}
            </div>

            {% if call.violations|length %}
                <table data-ui-role="table">
                    <thead>
                        <tr>
                            <th>Path</th>
                            <th>Message</th>
                            <th>Invalid value</th>
                            <th>Violation</th>
                        </tr>
                    </thead>
                    {% for violation in call.violations %}
                        <tr>
                            <td>{{ violation.propertyPath }}</td>
                            <td>{{ violation.message }}</td>
                            <td>{{ profiler_dump(violation.seek('invalidValue')) }}</td>
                            <td>{{ profiler_dump(violation) }}</td>
                        </tr>
                    {% endfor %}
                </table>
            {% else %}
                No violations
            {% endif %}
        </div>
    {% else %}
        <div data-ui-role="empty" data-ui-profiler-empty-panel>
            <p>No calls to the validator were collected.</p>
        </div>
    {% endfor %}
    </div>
{% endblock %}
