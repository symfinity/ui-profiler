{% extends '@UiProfiler/Profiler/layout.html.twig' %}
{% import '@UiProfiler/_chrome/macros/profiler-ui.html.twig' as ui %}

{% block toolbar %}
    {% set events = collector.events %}

    {% if events.messages|length %}
        {% set icon %}
            {{ source('@WebProfiler/Icon/notifier.svg') }}
            <span data-ui-profiler-wdt-value>{{ events.messages|length }}</span>
        {% endset %}

        {% set text %}
            {% from '@UiProfiler/_chrome/macros/wdt-markup.html.twig' import status_badge %}
            <div data-ui-profiler-wdt-info-piece>
                <b>Sent notifications</b>
                {{ status_badge('none', events.messages|length) }}
            </div>

            {% for transport in events.transports %}
                <div data-ui-profiler-wdt-info-piece>
                    <b>{{ transport ?: '<em>Empty Transport Name</em>' }}</b>
                    {{ status_badge('none', events.messages(transport)|length) }}
                </div>
            {% endfor %}
        {% endset %}

        {{ include('@WebProfiler/Profiler/toolbar_item.html.twig', {link: profiler_url}) }}
    {% endif %}
{% endblock %}

{% block head %}
    {{ parent() }}
{% endblock %}

{% block menu %}
    {% set events = collector.events %}
    {{ include('@UiProfiler/_chrome/partials/collector-menu-label.html.twig', {
        icon: source('@WebProfiler/Icon/notifier.svg'),
        title: 'Notifications',
        disabled: events.messages|length == 0,
        count: events.messages|length > 0 ? events.messages|length : null,
    }) }}
{% endblock %}

{% block panel %}
    <div data-ui-profiler-panel="notifier">
    {% set events = collector.events %}

    {{ include('@UiProfiler/_chrome/partials/collector-panel-heading.html.twig', { title: 'Notifications' }) }}
    {% if not events.messages|length %}
        <div data-ui-role="empty" data-ui-profiler-empty-panel>
            <p>No notifications were sent.</p>
        </div>
    {% endif %}

    <div data-ui-metrics-grid data-ui-role="grid">
        {% for transport in events.transports %}
            {{ ui.metric_cell(events.messages(transport)|length, transport) }}
        {% endfor %}
    </div>

    {% for transport in events.transports %}
        <h3 data-ui-role="typography" data-ui-variant="h3">{{ transport ?: '<em>Empty Transport Name</em>' }}</h3>

        <div data-ui-part="card-section">
            <div data-ui-profiler-tabs data-ui-role="tabs">
                {% for event in events.events(transport) %}
                    {% set message = event.message %}
                    <div class="tab">
                        <h3 class="tab-title" data-ui-role="typography" data-ui-variant="h3">Message #{{ loop.index }} <small>({{ event.isQueued() ? 'queued' : 'sent' }})</small></h3>
                        <div class="tab-content">
                            <div class="card">
                                <div data-ui-part="card-section">
                                    <span class="label">Subject</span>
                                    <h2 class="m-t-10">{{ message.getSubject() ?? '(empty)' }}</h2>
                                </div>
                                {% set notification = message.notification ?? null %}
                                {% if notification %}
                                    <div data-ui-part="card-section">
                                        <div class="row">
                                            <div class="col">
                                                <span class="label">Content</span>
                                                <pre data-ui-wrap="pre">{{ notification.getContent() ?? '(empty)' }}</pre>
                                                <span class="label">Importance</span>
                                                <pre data-ui-wrap="pre">{{ notification.getImportance() }}</pre>
                                            </div>
                                        </div>
                                    </div>
                                {% endif %}
                                    <div data-ui-part="card-section">
                                        <div data-ui-profiler-tabs data-ui-role="tabs">
                                            {% if notification %}
                                                <div class="tab">
                                                    <h3 class="tab-title" data-ui-role="typography" data-ui-variant="h3">Notification</h3>
                                                    <div class="tab-content">
                                                        <pre data-ui-wrap="pre" style="max-height: 600px">
                                                            {{- 'Subject: ' ~ notification.getSubject() }}<br/>
                                                            {{- 'Content: ' ~ notification.getContent() }}<br/>
                                                            {{- 'Importance: ' ~ notification.getImportance() }}<br/>
                                                            {{- 'Emoji: ' ~ (notification.getEmoji() is empty ? '(empty)' : notification.getEmoji()) }}<br/>
                                                            {{- 'Exception: ' ~ (notification.getException() ?? '(empty)') }}<br/>
                                                            {{- 'ExceptionAsString: ' ~ (notification.getExceptionAsString() is empty ? '(empty)' : notification.getExceptionAsString()) }}
                                                        </pre>
                                                    </div>
                                                </div>
                                            {% endif %}
                                                <div class="tab">
                                                    <h3 class="tab-title" data-ui-role="typography" data-ui-variant="h3">Message Options</h3>
                                                    <div class="tab-content">
                                                        <pre data-ui-wrap="pre" style="max-height: 600px">
                                                            {%- if message.getOptions() is null %}
                                                                {{- '(empty)' }}
                                                            {%- else %}
                                                                {{- message.getOptions().toArray()|json_encode(constant('JSON_PRETTY_PRINT')) }}
                                                            {%- endif %}
                                                        </pre>
                                                    </div>
                                                </div>
                                        </div>
                                    </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endfor %}
    </div>
{% endblock %}
