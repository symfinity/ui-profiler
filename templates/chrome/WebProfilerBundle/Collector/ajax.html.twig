{% extends '@UiProfiler/Profiler/layout.html.twig' %}

{% block toolbar %}
    {% set icon %}
        {{ source('@WebProfiler/Icon/ajax.svg') }}
        <span data-ui-profiler-wdt-ajax-counter>0</span>
    {% endset %}

    {% set text %}
        <div data-ui-profiler-wdt-info-piece>
            <span data-ui-profiler-wdt-info-header>
                <b data-ui-profiler-wdt-ajax-info></b>
                <b data-ui-profiler-wdt-info-action>(<a data-ui-profiler-wdt-ajax-clear href="javascript:void(0);">Clear</a>)</b>
            </span>
        </div>
        <div data-ui-profiler-wdt-info-piece>
            <table data-ui-role="table" data-ui-profiler-wdt-ajax-table>
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Profile</th>
                        <th>Method</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>URL</th>
                        <th>Time</th>
                    </tr>
                </thead>
                <tbody data-ui-profiler-wdt-ajax-list></tbody>
            </table>
        </div>
    {% endset %}

    {{ include('@WebProfiler/Profiler/toolbar_item.html.twig', {link: false, name: 'ajax'}) }}
{% endblock %}
