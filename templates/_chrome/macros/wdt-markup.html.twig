{# WDT v2 vocabulary — no sf-toolbar-* classes in owned markup #}

{% macro wdt_variant(color) -%}
    {%- if color in ['green', 'success'] -%}success
    {%- elseif color in ['red', 'danger'] -%}danger
    {%- elseif color in ['yellow', 'warning'] -%}warning
    {%- else -%}neutral
    {%- endif -%}
{%- endmacro %}

{% macro wdt_item_status(color) -%}
    {%- if color in ['green', 'success'] -%}success
    {%- elseif color in ['red', 'danger'] -%}danger
    {%- elseif color in ['yellow', 'warning'] -%}warning
    {%- else -%}normal
    {%- endif -%}
{%- endmacro %}

{% macro status_badge(color, content) %}
    <span data-ui-profiler-wdt-status data-ui-variant="{{ _self.wdt_variant(color) }}">{{ content }}</span>
{% endmacro %}
