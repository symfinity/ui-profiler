{# WDT v2 vocabulary — ux-blocks composition; no sf-toolbar-* classes #}

{% macro wdt_variant(color) -%}
    {%- if color in ['green', 'success'] -%}success
    {%- elseif color in ['red', 'danger'] -%}danger
    {%- elseif color in ['yellow', 'warning'] -%}warning
    {%- else -%}neutral
    {%- endif -%}
{%- endmacro %}

{% macro wdt_item_status(color) -%}
    {%- if color in ['green', 'success'] -%}success
    {%- elseif color in ['red', 'danger'] -%}danger
    {%- elseif color in ['yellow', 'warning'] -%}warning
    {%- else -%}normal
    {%- endif -%}
{%- endmacro %}

{% macro status_badge(color, content) %}
    <twig:Badge variant="{{ _self.wdt_variant(color) }}" size="sm">{{ content }}</twig:Badge>
{% endmacro %}
