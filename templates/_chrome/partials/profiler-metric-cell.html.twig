{# Single profiler metric — stat role inside [data-ui-metrics-grid]. #}
<div data-ui-role="stat" data-ui-gap="xs" data-ui-align="center">
    <span data-ui-part="value">{{ value|raw }}{% if unit|default(null) %} <span data-ui-part="unit">{{ unit }}</span>{% endif %}</span>
    <span data-ui-part="label">{{ label }}</span>
</div>
