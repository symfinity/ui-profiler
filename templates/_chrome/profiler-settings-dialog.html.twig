{% set preference = ui_profiler_theme_preference() %}
{% set theme_auto = preference.scheme.value == 'auto' %}
{% set ssr_theme_id = theme_auto ? null : ui_kernel_active_theme_id() %}
{% set theme_route_params = {token: token, type: profile_type|default('request')} %}
{% if panel %}
    {% set theme_route_params = theme_route_params|merge({panel: panel}) %}
{% endif %}

<dialog
    id="profiler-settings"
    data-ui-role="dialog"
    data-ui-fragment="blocks.dialog"
    {% if ssr_theme_id %}data-theme="{{ ssr_theme_id }}" {% endif %}
    aria-labelledby="profiler-settings-title"
    {% if ui_profiler_stimulus_enabled() %}data-controller="ui-profiler--dialog"{% endif %}
>
    <div data-ui-role="stack" data-ui-gap="lg">
        <header data-ui-role="stack" data-ui-direction="horizontal" data-ui-gap="md">
            <h3 id="profiler-settings-title">Configuration Settings</h3>
            <button
                type="button"
                data-ui-role="button"
                data-ui-variant="neutral"
                data-ui-appearance="ghost"
                data-ui-size="sm"
                data-ui-profiler-settings-close
                aria-label="Close"
            >&times;</button>
        </header>

        <div data-ui-role="stack" data-ui-gap="sm">
            <strong>Theme</strong>
            <div data-ui-role="grid" data-ui-columns="3" data-ui-profiler-settings-picker role="group" aria-label="Theme">
                <a
                    href="{{ path('ui_profiler_theme_preference', theme_route_params|merge({scheme: 'auto'})) }}"
                    data-ui-role="button"
                    data-ui-layout="block"
                    data-ui-variant="{{ preference.scheme.value == 'auto' ? 'primary' : 'neutral' }}"
                    {% if preference.scheme.value != 'auto' %}data-ui-appearance="ghost"{% endif %}
                    data-turbo="false"
                    data-no-turbolink
                >
                    {{ source('@WebProfiler/Icon/settings-theme-system.svg') }}
                    <span class="ui-profiler-settings-label">System / OS</span>
                </a>
                <a
                    href="{{ path('ui_profiler_theme_preference', theme_route_params|merge({scheme: 'light'})) }}"
                    data-ui-role="button"
                    data-ui-layout="block"
                    data-ui-variant="{{ preference.scheme.value == 'light' ? 'primary' : 'neutral' }}"
                    {% if preference.scheme.value != 'light' %}data-ui-appearance="ghost"{% endif %}
                    data-turbo="false"
                    data-no-turbolink
                >
                    {{ source('@WebProfiler/Icon/settings-theme-light.svg') }}
                    <span class="ui-profiler-settings-label">Light</span>
                </a>
                <a
                    href="{{ path('ui_profiler_theme_preference', theme_route_params|merge({scheme: 'dark'})) }}"
                    data-ui-role="button"
                    data-ui-layout="block"
                    data-ui-variant="{{ preference.scheme.value == 'dark' ? 'primary' : 'neutral' }}"
                    {% if preference.scheme.value != 'dark' %}data-ui-appearance="ghost"{% endif %}
                    data-turbo="false"
                    data-no-turbolink
                >
                    {{ source('@WebProfiler/Icon/settings-theme-dark.svg') }}
                    <span class="ui-profiler-settings-label">Dark</span>
                </a>
            </div>
        </div>

        <div data-ui-role="stack" data-ui-gap="sm">
            <strong>Page Width</strong>
            <div data-ui-role="grid" data-ui-columns="2" data-ui-profiler-settings-picker role="radiogroup" aria-label="Page width">
                <label data-ui-role="button" data-ui-layout="block" data-ui-variant="neutral" data-ui-appearance="ghost" for="settings-width-normal">
                    <input
                        class="config-option config-option-width visually-hidden"
                        type="radio"
                        name="width"
                        value="normal"
                        id="settings-width-normal"
                    >
                    {{ source('@WebProfiler/Icon/settings-width-fixed.svg') }}
                    <span class="ui-profiler-settings-label">Fixed width</span>
                </label>
                <label data-ui-role="button" data-ui-layout="block" data-ui-variant="neutral" data-ui-appearance="ghost" for="settings-width-full">
                    <input
                        class="config-option config-option-width visually-hidden"
                        type="radio"
                        name="width"
                        value="full"
                        id="settings-width-full"
                    >
                    {{ source('@WebProfiler/Icon/settings-width-fitted.svg') }}
                    <span class="ui-profiler-settings-label">Fit to window</span>
                </label>
            </div>
        </div>
    </div>
</dialog>

<script{% if csp_script_nonce is defined and csp_script_nonce %} nonce="{{ csp_script_nonce }}"{% endif %}>
(function () {
    const dialog = document.getElementById('profiler-settings');
    const openButton = document.getElementById('open-settings');
    const closeButton = dialog?.querySelector('[data-ui-profiler-settings-close]');
    const widthInputs = document.querySelectorAll('.config-option-width');

    if (!dialog || !openButton) {
        return;
    }

    const applyWidthClass = (settingValue) => {
        const shell = document.querySelector('[data-ui-profiler-shell]');
        [document.body, shell].forEach((node) => {
            if (!(node instanceof HTMLElement)) {
                return;
            }
            node.classList.forEach((cssClass) => {
                if (cssClass.startsWith('width')) {
                    node.classList.remove(cssClass);
                }
            });
            node.classList.add(settingValue);
        });
    };

    const syncWidthVariant = () => {
        const widthSetting = localStorage.getItem('symfony/profiler/width') || 'width-normal';
        const widthValue = widthSetting.replace(/^width-/, '');

        widthInputs.forEach((input) => {
            if (!(input instanceof HTMLInputElement)) {
                return;
            }

            const isActive = input.value === widthValue;
            input.checked = isActive;
            const label = input.closest('label[data-ui-role="button"]');
            if (label instanceof HTMLElement) {
                label.dataset.uiVariant = isActive ? 'primary' : 'neutral';
                if (isActive) {
                    delete label.dataset.uiAppearance;
                } else {
                    label.dataset.uiAppearance = 'ghost';
                }
            }
        });

        applyWidthClass(widthSetting);
    };

    syncWidthVariant();

    widthInputs.forEach((option) => {
        option.addEventListener('change', function (event) {
            event.stopPropagation();

            const settingValue = 'width-' + option.value;
            localStorage.setItem('symfony/profiler/width', settingValue);
            applyWidthClass(settingValue);
            syncWidthVariant();
        });
    });

    document.querySelectorAll('[data-ui-profiler-settings-picker] label[data-ui-role="button"]').forEach((label) => {
        label.addEventListener('click', (event) => {
            const input = label.querySelector('input[type="radio"]');
            if (!(input instanceof HTMLInputElement)) {
                return;
            }

            if (event.target === input) {
                return;
            }

            event.preventDefault();
            input.checked = true;
            input.dispatchEvent(new Event('change', { bubbles: true }));
        });
    });

    openButton.addEventListener('click', function (event) {
        event.preventDefault();
        syncWidthVariant();

        if (typeof dialog.showModal === 'function') {
            dialog.showModal();
        } else {
            dialog.setAttribute('open', 'open');
        }

        closeButton?.focus();
    });

    closeButton?.addEventListener('click', () => {
        dialog.close();
    });

    dialog.addEventListener('click', (event) => {
        if (event.target === dialog) {
            dialog.close();
        }
    });

    dialog.addEventListener('close', () => {
        openButton.focus();
    });
})();
</script>
